# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Server-side AI gateway (never expose these values to the browser) ──
KIMI_AGENTGW_BASE_URL=    # Platform-injected gateway URL
KIMI_AGENTGW_API_KEY=     # Platform-injected server credential

# ── Object storage ──────────────────────────────────────────────
KIMI_STORAGE_RESOURCE_ID= # Platform storage resource ID (not a credential)

# ── Optional PhotoCraft override (server only) ──────────────────
# Linux x86_64 uses the pinned vendor runtime when this is empty.
PHOTOCRAFT_CLI_BIN=       # Absolute path to photocraft-cli or PhotoCraft AppImage
